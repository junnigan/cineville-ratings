{
  "manifest_version": 3,
  "name": "Cineville Ratings",
  "version": "0.4.1",
  "description": "Shows TMDB / IMDb / NeoDB / Douban ratings, localized titles, synopses and short reviews on Cineville.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://cineville.nl/*",
    "https://neodb.social/*",
    "https://movie.douban.com/*",
    "https://www.imdb.com/*",
    "https://www.omdbapi.com/*",
    "https://api.themoviedb.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cineville.nl/*",
        "https://www.cineville.nl/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Cineville Ratings settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}